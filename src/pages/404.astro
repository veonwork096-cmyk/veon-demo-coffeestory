---
import Base from "../layouts/Base.astro";
---
<Base lang="uk" title="Сторінку не знайдено — Coffee-Story" description="Такої сторінки немає. Поверніться на головну Coffee-Story.">
  <section class="nf on-field">
    <div class="container">
      <h1>Такої сторінки немає</h1>
      <p>Можливо, адресу змінено. Каву й контакти знайдете на головній.</p>
      <a class="btn" href="/">На головну</a>
    </div>
  </section>
</Base>

<style>
  .nf { min-height: 100svh; display: grid; align-items: center; padding-block: var(--s-7); }
  .nf .container { display: grid; gap: var(--s-4); justify-items: start; }
  .nf p { font-size: var(--fs-lead); color: var(--well); }
</style>
