---
import { Picture } from "astro:assets";
import FutureLink from "./FutureLink.astro";
import { contacts, heroes, soon } from "../data/site";

// Stage order: Шеф — Лис (centre, biggest) — Ведмідь
const byId = Object.fromEntries(heroes.map((h) => [h.id, h]));
const cast = [
  { hero: byId.shef, role: "side left", label: "Від шефа" },
  { hero: byId.lys, role: "lead", label: "Еспресо" },
  { hero: byId.vedmid, role: "side right", label: "Під фільтр" },
];
---
<section id="top" class="hero on-field" data-rec="R-001">
  <div class="container intro">
    <h1 data-rec="R-104,R-109">Кава власного обсмаження з доставкою по Україні</h1>
    <p class="lead">Обсмажуємо зерно у власному цеху в Дніпрі й відправляємо Новою поштою в будь-яке місто.</p>
    <div class="actions">
      <FutureLink note={soon} class="btn btn-hero">Обрати каву</FutureLink>
      <a class="link call-link" href={contacts.phoneHref}>Замовити за телефоном <span class="num">{contacts.phone}</span></a>
    </div>
  </div>

  <div class="stage container" aria-label="Три герої пачок Coffee-Story">
    {cast.map(({ hero, role, label }) => (
      <a class:list={["pack", role]} href={`#heroi-${hero.id}`} data-hero-link={hero.id}>
        <span class="pack-label">{label}<span class="visually-hidden">: {hero.name}, сорти і ціни</span></span>
        <Picture
          src={hero.img}
          alt={hero.alt}
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          widths={role === "lead" ? [320, 640, 960] : [240, 480, 720]}
          sizes={role === "lead" ? "(min-width: 1024px) 444px, 46vw" : "(min-width: 1024px) 366px, 38vw"}
          loading="eager"
          fetchpriority={role === "lead" ? "high" : "auto"}
          decoding={role === "lead" ? "sync" : "async"}
          pictureAttributes={role === "lead" ? { "data-rec": "R-202" } : {}}
        />
      </a>
    ))}
  </div>
</section>

<style>
  .hero { position: relative; z-index: 1; padding-top: var(--s-5); overflow-x: clip; }
  .intro { display: grid; gap: var(--s-4); }
  h1 { max-width: 12ch; text-wrap: balance; }
  .lead { font-size: var(--fs-lead); line-height: 1.5; color: var(--well); max-width: 40ch; }
  .actions { display: grid; gap: var(--s-3); justify-items: start; }
  .actions :global(.btn-hero) { width: 100%; text-decoration: none; }
  .call-link { min-height: 44px; display: inline-flex; flex-wrap: wrap; align-items: center; column-gap: .4em; }

  /* Mobile: a fan of three packs, Лис in front */
  .stage { --lead-w: min(208px, 46vw); --side-w: min(172px, 38vw); --tuck: 8vw; position: relative; height: calc(var(--lead-w) * 1.04 + var(--s-4)); margin-top: var(--s-5); margin-bottom: -64px; display: flex; justify-content: center; }
  .pack { position: absolute; bottom: 0; display: block; text-decoration: none; color: var(--paper); }
  .pack :global(img) { width: 100%; height: auto; }
  .pack-label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .pack.lead { width: var(--lead-w); z-index: 3; left: 50%; margin-left: calc(var(--lead-w) / -2); bottom: 0; }
  .pack.side { width: var(--side-w); z-index: 2; bottom: var(--s-4); }
  .pack.left { left: 50%; margin-left: calc(var(--lead-w) / -2 + var(--tuck) - var(--side-w)); rotate: -9deg; }
  .pack.right { left: 50%; margin-left: calc(var(--lead-w) / 2 - var(--tuck)); rotate: 9deg; }
  .pack:focus-visible { outline-offset: 4px; }

  @media (min-width: 600px) {
    .actions { display: flex; flex-wrap: wrap; align-items: center; column-gap: var(--s-5); row-gap: var(--s-3); }
    .actions :global(.btn-hero) { width: auto; padding-inline: 2rem; }
  }

  /* Desktop: the cast on the edge of the stage */
  @media (min-width: 1024px) {
    .hero { padding-top: var(--s-6); }
    .intro { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gap); row-gap: var(--s-4); }
    .intro > * { grid-column: 1 / span 10; }
    h1 { max-width: none; }
    .lead { grid-column: 1 / span 6; }
    .stage { height: auto; margin-top: var(--s-3); margin-bottom: -48px; display: flex; align-items: flex-end; justify-content: center; }
    .pack { position: relative; left: auto; bottom: auto; margin: 0; rotate: none; display: flex; flex-direction: column; align-items: center; }
    .pack.lead { width: 444px; margin: 0 -28px; left: auto; }
    .pack.side { width: 366px; bottom: auto; margin-bottom: 40px; }
    .pack.left, .pack.right { left: auto; margin-left: 0; rotate: none; }
    .pack-label {
      position: static; width: auto; height: auto; overflow: visible; clip: auto; white-space: nowrap;
      margin-bottom: var(--s-3); font-weight: 700; font-size: 1.0625rem; color: var(--paper);
      text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: .25em;
    }
    .pack:hover .pack-label { text-decoration-thickness: 3px; }
  }

  /* Motion 1: «вихід на поклон». Лис moves only (no opacity), so the LCP image is painted at once.
     One keyframe set; the distance and stagger come from custom properties, so a viewport change never restarts it. */
  .stage { --bow: 8px; --bow-step: 0ms; }
  @keyframes bow-in { from { opacity: 0; translate: 0 var(--bow); } }
  @keyframes bow-lead { from { translate: 0 var(--bow); } }
  .pack :global(picture) { display: block; width: 100%; }
  .pack.lead :global(picture) { animation: bow-lead var(--dur) var(--ease-out) both; }
  .pack.side :global(picture) { animation: bow-in var(--dur) var(--ease-out) both; }
  .pack.left :global(picture) { animation-delay: var(--bow-step); }
  .pack.right :global(picture) { animation-delay: calc(var(--bow-step) * 2); }
  @media (min-width: 1024px) { .stage { --bow: 16px; --bow-step: 80ms; } }
  @media (prefers-reduced-motion: reduce) {
    .pack :global(picture) { animation: none !important; }
  }
</style>
