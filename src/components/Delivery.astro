---
import FutureLink from "./FutureLink.astro";
import { delivery, payments, soon } from "../data/site";
---
<section id="dostavka" class="delivery">
  <div class="container grid">
    <h2>Новою поштою, кур'єром по Дніпру чи з цеху</h2>
    <div class="col">
      <h3>Отримання</h3>
      <ul class="ways">
        {delivery.map((d) => <li><strong>{d.title}</strong><span>{d.text}</span></li>)}
      </ul>
    </div>
    <div class="col">
      <h3>Оплата</h3>
      <ul class="pay">
        {payments.map((p) => <li>{p}</li>)}
      </ul>
    </div>
    <p class="more"><FutureLink note={soon}>Детальніше про доставку й оплату</FutureLink></p>
  </div>
</section>

<style>
  .delivery { padding-block: var(--s-7) var(--s-6); }
  .grid { display: grid; gap: var(--s-5); }
  h3 { margin-bottom: var(--s-3); }
  .ways { display: grid; }
  .ways li { display: grid; gap: .25rem; padding-block: var(--s-3); border-top: 1px solid var(--muted); }
  .ways strong { font-size: 1.125rem; }
  .ways span { color: var(--muted); }
  .pay { display: grid; border-top: 1px solid var(--muted); }
  .pay li { padding-block: var(--s-2); border-bottom: 1px solid var(--well); }
  .more :global(.future-link) { min-height: 44px; color: var(--link); }

  @media (min-width: 768px) {
    .grid { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gap); }
    h2 { grid-column: 1 / -1; }
    .col:nth-of-type(1) { grid-column: 1 / span 7; }
    .col:nth-of-type(2) { grid-column: 9 / span 4; }
    .more { grid-column: 1 / -1; }
  }
  @media (min-width: 1024px) {
    .delivery { padding-block: var(--s-8) var(--s-7); }
    h2 { grid-column: 1 / span 8; }
  }
</style>
