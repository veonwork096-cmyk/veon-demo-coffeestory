---
import { contacts, grinds } from "../data/site";
---
<section id="obsmazhennia" data-rec="R-005" class="fresh on-field">
  <div class="container grid">
    <div class="head">
      <h2>Обсмажили — і рахуємо дні</h2>
      <p>Смак і аромат кави формуються від першого дня до трьох місяців після обсмаження.</p>
    </div>

    <figure class="scale">
      <ol class="points" aria-label="Формування смаку й аромату кави після обсмаження">
        <li class="point"><span class="dot" aria-hidden="true"></span><strong class="display">1 день</strong><span>після обсмаження</span></li>
        <li class="span" aria-hidden="true"><span class="line"><span class="fill" data-reveal></span></span></li>
        <li class="point point-end"><span class="dot" aria-hidden="true"></span><strong class="display">3 місяці</strong><span>після обсмаження</span></li>
      </ol>
      <figcaption>Між цими точками формуються смак і аромат кави.</figcaption>
    </figure>

    <ul class="facts">
      <li><strong>Вівторок і четвер.</strong> Усі сорти, крім рідкісних та елітних, обсмажуємо двічі на тиждень.</li>
      <li><strong>Під кожне замовлення.</strong> Рідкісні й елітні сорти — до обраного рівня обсмаження.</li>
      <li><strong>Під ваш спосіб заварювання.</strong> Обсмаження — еспресо, фільтр чи під молоко; помел — за запитом: {grinds.map((g, i) => <><span class="nw">{g}</span>{i < grinds.length - 1 ? ", " : "."}</>)}</li>
    </ul>

    <p class="call"><a class="link" href={contacts.phoneHref}>Порадимо помел — подзвоніть</a></p>
  </div>
</section>

<style>
  .fresh { padding-block: var(--s-6); }
  .grid { display: grid; gap: var(--s-5); }
  .head { display: grid; gap: var(--s-3); }
  .head p { font-size: var(--fs-lead); color: var(--muted-on); }

  /* Scale «1 день — 3 місяці» (C-016): two labelled points on a neutral line, no invented middle values.
     Mobile: vertical and static. */
  .scale { margin: 0; display: grid; gap: var(--s-3); }
  .points { display: grid; grid-template-columns: 20px 1fr; column-gap: var(--s-3); }
  .point { display: contents; }
  .dot { grid-column: 1; width: 20px; height: 20px; border-radius: 50%; border: 3px solid var(--paper); background: var(--field); align-self: start; margin-top: .35rem; }
  .point strong { grid-column: 2; font-size: var(--fs-index); line-height: 1.1; color: var(--paper); font-weight: 400; }
  .point span:not(.dot) { grid-column: 2; color: var(--well); }
  .point-end .dot { background: var(--paper); }
  .span { grid-column: 1; display: flex; justify-content: center; min-height: var(--s-6); padding-block: var(--s-1); }
  .line { display: block; position: relative; width: 3px; background: color-mix(in oklab, var(--paper) 30%, transparent); border-radius: var(--radius-pill); overflow: hidden; }
  .fill { position: absolute; inset: 0; background: var(--paper); }
  figcaption { color: var(--well); font-size: var(--fs-body); }

  .facts { display: grid; gap: var(--s-3); }
  .facts li { max-width: 60ch; }
  .facts strong { color: var(--paper); }
  .facts li { color: var(--well); }
  .call { font-size: var(--fs-lead); }
  .call .link { min-height: 44px; display: inline-flex; align-items: center; }

  .nw { white-space: nowrap; }
  .facts li { font-size: var(--fs-body); }

  @media (min-width: 768px) {
    .points { grid-template-columns: auto minmax(0, 1fr) auto; grid-template-rows: auto auto auto; column-gap: var(--s-4); align-items: center; }
    .point { display: grid; grid-row: 1 / span 3; grid-template-rows: subgrid; row-gap: var(--s-1); justify-items: start; }
    .point:first-child { grid-column: 1; }
    .point-end { grid-column: 3; justify-items: end; text-align: right; }
    .dot { grid-row: 2; grid-column: auto; margin: 0; align-self: center; }
    .point strong { grid-row: 1; grid-column: auto; }
    .point span:not(.dot) { grid-row: 3; grid-column: auto; }
    .span { grid-column: 2; grid-row: 2; min-height: 0; padding: 0; display: block; }
    .line { width: auto; height: 3px; }
    /* Motion 3: the line fills from «1 день» to «3 місяці» once, when the block comes into view. */
    .fill { transform-origin: left; transition: transform 900ms var(--ease-out); }
    :global(.js) .fill[data-reveal]:not(.is-visible) { opacity: 1; transform: scaleX(0); }
  }
  @media (max-width: 767px) {
    :global(.js) .fill[data-reveal]:not(.is-visible) { opacity: 1; transform: none; }
  }
  @media (min-width: 1024px) {
    .fresh { padding-block: var(--s-8) var(--s-7); }
    .grid { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gap); row-gap: var(--s-6); }
    .head { grid-column: 1 / span 8; }
    .scale, .facts { grid-column: 1 / -1; }
    .call { grid-column: 1 / -1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .fill { transition: none; }
    :global(.js) .fill[data-reveal]:not(.is-visible) { transform: none; }
  }
</style>
