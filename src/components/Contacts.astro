---
import FutureLink from "./FutureLink.astro";
import { contacts, soon } from "../data/site";
---
<section id="kontakty" data-rec="R-010" class="contacts on-field">
  <div class="container grid">
    <h2>Контакти цеху обсмаження в Дніпрі</h2>

    <div class="phone-block">
      <a class="phone display num" href={contacts.phoneHref}><span>+38 (068)</span> <span>48-27-286</span></a>
      <p class="hours">Телефон: {contacts.hours}</p>
    </div>

    <dl class="list">
      <div>
        <dt>Адреса цеху</dt>
        <dd>
          <address>м. {contacts.city}, {contacts.address}</address>
          <span class="sub">Самовивіз — за попереднім замовленням</span>
          <a class="link" href={contacts.map} target="_blank" rel="noopener noreferrer">Відкрити на карті<span class="visually-hidden"> (нова вкладка)</span></a>
        </dd>
      </div>
      <div>
        <dt>Пошта</dt>
        <dd><a class="link" href={`mailto:${contacts.email}`}>{contacts.email}</a></dd>
      </div>
      <div>
        <dt>Соцмережі</dt>
        <dd class="socials" data-rec="R-312">
          <a class="link" href={contacts.instagram} target="_blank" rel="noopener noreferrer">Instagram<span class="visually-hidden"> (нова вкладка)</span></a>
          <a class="link" href={contacts.facebook} target="_blank" rel="noopener noreferrer">Facebook<span class="visually-hidden"> (нова вкладка)</span></a>
        </dd>
      </div>
      <div>
        <dt>Для імпортерів і обсмажувачів</dt>
        <dd><FutureLink note={soon}>Співпраця</FutureLink></dd>
      </div>
    </dl>
  </div>
</section>

<style>
  .contacts { padding-block: var(--s-6) var(--s-5); }
  .grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--s-5); }
  .phone { display: inline-block; font-size: clamp(1.75rem, 1rem + 3.4vw, 3.5rem); line-height: 1.1; color: var(--paper); text-decoration: none; }
  .phone span { white-space: nowrap; }
  .phone:hover { text-decoration: underline; text-decoration-thickness: 3px; text-underline-offset: .15em; }
  .hours { margin-top: var(--s-2); color: var(--well); font-size: var(--fs-lead); }
  .list { display: grid; gap: var(--s-4); margin: 0; }
  dt { font-size: var(--fs-small); color: var(--well); margin-bottom: .25rem; }
  dd { margin: 0; display: grid; gap: .25rem; justify-items: start; }
  address { font-style: normal; font-size: var(--fs-lead); font-weight: 700; }
  .sub { color: var(--well); }
  .socials { display: flex; flex-wrap: wrap; gap: var(--s-4); }
  .list .link, .list :global(.future-link) { min-height: 44px; display: inline-flex; align-items: center; }

  @media (min-width: 1024px) {
    .contacts { padding-block: var(--s-8) var(--s-6); }
    .grid { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gap); row-gap: var(--s-6); }
    h2 { grid-column: 1 / -1; }
    .phone-block { grid-column: 1 / span 7; }
    .phone { white-space: nowrap; font-size: min(3.25rem, 3.9vw); }
    .list { grid-column: 9 / span 4; }
  }
</style>
